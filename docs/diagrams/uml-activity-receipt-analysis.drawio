                </mxCell>
                <mxCell id="n-429" value="429 RATE_LIMITED&#xa;problem+json + Retry-After&#xa;(no analysis performed)" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a33a32;" parent="L2" vertex="1">
                    <mxGeometry x="240" y="350" width="130" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n-validate" value="Validate hostile input:&#xa;sniff decoded content, enforce 10 MB,&#xa;check pixel count and dimensions" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#141414;" parent="L2" vertex="1">
                    <mxGeometry x="20" y="450" width="200" height="70" as="geometry"/>
