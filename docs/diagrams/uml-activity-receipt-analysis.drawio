                </mxCell>
                <mxCell id="subtitle" value="Supersedes the PRD §7 flowchart for this flow. Partitions follow the dependency direction: Client → Adapters → Application → Domain." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="30" y="50" width="1000" height="20" as="geometry"/>
